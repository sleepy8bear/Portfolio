---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Float from '../components/Float.astro';
---

<BaseLayout
  title="Contact — Hélène David"
  description="Get in touch with Hélène David — CEO & co-founder of CalmCampus, based in Leuven, Belgium."
>
  <PageHero label="contact" lead="Whether it’s about CalmCampus, student wellbeing, a project, or just a conversation, I’d love to hear from you.">
    Say <em>hello</em>
  </PageHero>

  <section class="has-float">
    <Float kind="flower" color="blush" size={170} speed={0.12} spin style="right:-40px;top:6%" />
    <Float kind="blob" color="custard" size={110} speed={-0.1} style="left:-30px;bottom:8%" />
    <div class="container">
      <span class="hand">write to me at</span>
      <a href="mailto:helene.david@proton.me" class="mail-big"><span class="squiggle">helene.david@proton.me</span></a>

      <div class="contact-list">
        <a href="https://www.linkedin.com/in/helenedavid11" target="_blank" rel="noopener" class="paper paper--blush reveal" style="--r:-1.2deg">
          <span class="hand">or find me on</span>
          <b>LinkedIn ↗</b>
        </a>
        <div class="paper paper--custard reveal" style="--r:1.2deg; --tape:4deg">
          <span class="hand">based in</span>
          <b>Leuven, Belgium</b>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
