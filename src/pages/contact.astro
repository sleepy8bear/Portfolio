---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Float from '../components/Float.astro';
---

<BaseLayout
  title="Contact — Hélène David"
  description="Get in touch with Hélène David — CEO & co-founder of CalmCampus, based in Leuven, Belgium."
>
  <PageHero label="contact" lead="Whether it’s about CalmCampus, student wellbeing, a project, or just a conversation, I’d love to hear from you.">
    Say <em>hello</em>
  </PageHero>

  <section class="has-float contact-section">
    <Float kind="flower" color="blush" size={170} speed={0.12} spin style="right:-40px;top:4%" />
    <Float kind="blob" color="custard" size={110} speed={-0.1} style="left:-30px;bottom:6%" />
    <Float kind="star" color="flamingo" size={80} speed={0.14} spin style="left:6%;top:3%" />
    <div class="container">

      <article class="postcard reveal">
        <!-- front: the picture side -->
        <div class="pc-front">
          <h2 data-split>Greetings<br />from <em>Leuven</em></h2>
          <svg class="pc-scene" viewBox="0 0 320 150" aria-hidden="true" overflow="visible">
            <circle cx="236" cy="52" r="34" fill="#f3ddb2" stroke="#5f2621" stroke-width="3" />
            <path d="M40 150 V92 A60 60 0 0 1 160 92 V150 Z" fill="#fffaf2" stroke="#5f2621" stroke-width="3" stroke-linejoin="round" />
            <path d="M62 150 V94 A38 38 0 0 1 138 94 V150" fill="none" stroke="#5f2621" stroke-width="2.4" stroke-dasharray="2 8" stroke-linecap="round" />
            <path d="M-4 128 q 14 -18 28 0 t 28 0 t 28 0 t 28 0 t 28 0 t 28 0 t 28 0 t 28 0 t 28 0 t 28 0 t 28 0 t 28 0" fill="none" stroke="#5f2621" stroke-width="3.2" stroke-linecap="round" />
          </svg>
          <span class="hand pc-wish">wish you were here</span>
        </div>

        <!-- back: stamp, postmark and the address lines -->
        <div class="pc-back">
          <div class="pc-stamp" aria-hidden="true">
            <img src="/logo.png" alt="" width="400" height="400" loading="lazy" />
            <svg class="pc-postmark" viewBox="0 0 150 90" aria-hidden="true">
              <defs><path id="pmark" d="M45 45 m-30 0 a30 30 0 1 1 60 0 a30 30 0 1 1 -60 0" /></defs>
              <circle cx="45" cy="45" r="38" fill="none" stroke="currentColor" stroke-width="2.2" />
              <circle cx="45" cy="45" r="22" fill="none" stroke="currentColor" stroke-width="1.6" />
              <text font-family="Instrument Sans, sans-serif" font-weight="700" font-size="9.6" letter-spacing="2" fill="currentColor"><textPath href="#pmark" startOffset="2">LEUVEN ✺ BELGIUM ✺</textPath></text>
              <path d="M88 24 q 11 -8 22 0 t 22 0 M88 40 q 11 -8 22 0 t 22 0 M88 56 q 11 -8 22 0 t 22 0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
            </svg>
          </div>

          <div class="pc-lines">
            <div class="pc-line">
              <span class="hand">write to me at</span>
              <a href="mailto:helene.david@proton.me" class="pc-mail"><span class="squiggle">helene.david@proton.me</span></a>
            </div>
            <div class="pc-line">
              <span class="hand">or find me on</span>
              <a href="https://www.linkedin.com/in/helenedavid11" target="_blank" rel="noopener" class="pc-link">linkedin.com/in/helenedavid11 ↗</a>
            </div>
            <div class="pc-line">
              <span class="hand">based in</span>
              <b class="pc-place">Leuven, Belgium</b>
            </div>
          </div>
        </div>
      </article>

    </div>
  </section>
</BaseLayout>
