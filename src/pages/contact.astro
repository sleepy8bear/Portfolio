---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contact — Hélène David"
  description="Get in touch with Hélène David — CEO & co-founder of CalmCampus, based in Leuven, Belgium."
>
  <PageHero label="Contact" lead="Whether it's about CalmCampus, student wellbeing, or just a conversation — I'd love to hear from you.">
    Let's <em>Connect</em>
  </PageHero>

  <!-- CONTACT CARDS -->
  <section class="contact-cards-section">
    <div class="container">
      <span class="section-label">Reach Out</span>
      <h2 style="margin-bottom: 2rem;">Get in Touch</h2>
      <div class="contact-links">

        <a href="mailto:helene.david@proton.me" class="contact-card">
          <div class="contact-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M2 7l10 7 10-7"/>
            </svg>
          </div>
          <div>
            <div class="contact-label">Email</div>
            <div class="contact-value">helene.david@proton.me</div>
          </div>
        </a>

        <a href="https://www.linkedin.com/in/helenedavid11" target="_blank" rel="noopener" class="contact-card">
          <div class="contact-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </div>
          <div>
            <div class="contact-label">LinkedIn</div>
            <div class="contact-value">helenedavid11</div>
          </div>
        </a>

      </div>
    </div>
  </section>
</BaseLayout>
