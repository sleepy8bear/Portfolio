---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaStrip from '../components/CtaStrip.astro';
import { projects } from '../data/projects';
import Float from '../components/Float.astro';

const education = [
  { year: 'Sep 2024 — Jul 2027', title: 'International Business Management', where: 'UC Leuven-Limburg · Marketing option', c: 'paper--custard', r: -1.2 },
  { year: 'Jun — Jul 2026', title: 'International Summer Program: Linear Algebra', where: 'Korea University', c: 'paper--blush', r: 1.4 },
  { year: 'Feb — Jun 2024', title: 'Bachelor of Science, Biomedical Sciences', where: 'Université Libre de Bruxelles (ULB)', c: '', r: 0.8 },
  { year: 'Sep 2023 — Jan 2024', title: 'Bachelor of Arts, Political Science', where: 'Université Libre de Bruxelles (ULB)', c: '', r: -1 },
  { year: 'Sep 2009 — Jul 2023', title: 'European Baccalaureate', where: 'European School of Luxembourg I', c: 'paper--flamingo', r: 1.1 },
];

const skills = [
  ['Product innovation', 'var(--custard)', -2], ['Pitch & presentation', 'var(--blush)', 1.5], ['Brand identity', 'var(--flamingo)', -1],
  ['Typography', 'var(--paper)', 2], ['Marketing strategy', 'var(--blush)', -1.5], ['Digital marketing', 'var(--custard)', 1],
  ['SEO', 'var(--flamingo)', -2], ['Graphic design', 'var(--custard)', 1.5], ['Adobe Photoshop', 'var(--paper)', -1],
  ['Entrepreneurship', 'var(--blush)', 2], ['Linear algebra', 'var(--custard)', -1.5], ['Social media', 'var(--flamingo)', 1],
] as const;

const langs = [
  ['French', 'native or bilingual'],
  ['English', 'full professional'],
  ['Dutch', 'limited working'],
  ['German', 'limited working'],
];

const certs = [
  ['LinkedIn Marketing Strategy', 'var(--custard)', -4],
  ['Graphic Design Essentials', 'var(--blush)', 3],
  ['SEO Essentials with Semrush', 'var(--flamingo)', -2],
  ['Getting Started with Semrush', 'var(--paper)', 4],
  ['Inbound Sales', 'var(--custard)', -3],
] as const;
---

<BaseLayout
  title="About — Hélène David"
  description="About Hélène David — International Business Management student (marketing option) and CEO & co-founder of CalmCampus."
>
  <PageHero label="about" lead="21 years old, based in Leuven. Curious about how the world works and how people think.">
    Hi, I’m <em>Hélène</em>
  </PageHero>

  <section>
    <div class="container about-grid">
      <div class="about-text">
        <p class="reveal">I’m a 21-year-old student in an International Business Management programme with a marketing option, driven by a fascination with understanding how the world functions and decoding people’s thought processes.</p>
        <p class="reveal">Before that I studied Political Science and Biomedical Sciences at ULB, after finishing the European Baccalaureate at the European School of Luxembourg I. In summer 2026 I took part in the International Summer Program in Linear Algebra at Korea University.</p>
        <p class="reveal">These days most of my work sits where brand, marketing and technology meet: a wellbeing startup, campaigns, and quite a lot of typography.</p>
      </div>
      <div class="note-card reveal">
        <span class="hand">the short version</span>
        <ul>
          <li>CEO &amp; co-founder, CalmCampus</li>
          <li>Head of social media, <a href="https://www.instagram.com/insignialeuven/" target="_blank" rel="noopener" class="squiggle">Insignia</a></li>
          <li><b data-count={projects.length}>{projects.length}</b> projects so far</li>
          <li>4 languages</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="tint">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">education</span><h2 data-split>Where I’ve <em>studied</em></h2></div></div>
      <div class="edu">
        {education.map((e) => (
          <div class:list={['paper', e.c, 'reveal']} style={`--r:${e.r}deg`}>
            <div class="year">{e.year}</div>
            <h3>{e.title}</h3>
            <p class="where">{e.where}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="has-float">
    <Float kind="squiggle" color="blush" size={170} speed={0.1} style="right:4%;top:6%" />
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">skills</span><h2 data-split>Things I’m <em>good</em> at</h2></div></div>
      <div class="skills-wrap">
        {skills.map(([label, bg, r]) => <span class="sticker reveal" style={`--c:${bg}; --r:${r}deg`}>{label}</span>)}
      </div>
    </div>
  </section>

  <section class="tint">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">languages</span><h2 data-split>I speak <em>four</em></h2></div></div>
      <div class="langs">
        {langs.map(([name, level]) => <div class="lang reveal"><b>{name}</b><span>{level}</span></div>)}
      </div>
    </div>
  </section>

  <section class="has-float">
    <Float kind="flower" color="custard" size={140} speed={0.13} spin style="right:-30px;bottom:6%" />
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">certifications</span><h2 data-split>Collected <em>stamps</em></h2></div></div>
      <div class="stamps">
        {certs.map(([label, bg, r]) => <div class="stamp reveal" style={`--c:${bg}; --r:${r}deg`}><span>{label}</span></div>)}
      </div>
    </div>
  </section>

  <CtaStrip
    text="Always happy to chat about ideas, projects or collaborations."
    primary={{ href: '/contact.html', label: 'Get in touch' }}
    secondary={{ href: '/projects.html', label: 'See the projects' }}
  >
    Want to know <em>more</em>?
  </CtaStrip>
</BaseLayout>
