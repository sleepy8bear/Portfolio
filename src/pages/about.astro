---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaStrip from '../components/CtaStrip.astro';
---

<BaseLayout
  title="About — Hélène David"
  description="About Hélène David — International Business Management student (Marketing option) and CEO & co-founder of CalmCampus."
>
  <PageHero label="About" lead="21 years old, based in Leuven — fascinated by how the world works and how people think.">
    The Person<br />Behind the <em>Work</em>
  </PageHero>

  <!-- ABOUT -->
  <section>
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <span class="section-label">Background</span>
          <h2>Understanding how the world works — and how people think.</h2>
          <p>I'm a 21-year-old student in an International Business Management (IBM) programme, with a Marketing option. My academic journey is driven by a fascination with understanding how the world functions and decoding people's thought processes.</p>
          <p>Before that, I studied Political Science and Biomedical Sciences at ULB, after completing the European Baccalaureate at the European School of Luxembourg I. In summer 2026 I took part in the International Summer Program at Korea University.</p>
        </div>
        <div class="about-stats">
          <div class="stat">
            <span class="stat-num">4</span>
            <span class="stat-label">Languages spoken</span>
          </div>
          <div class="stat">
            <span class="stat-num">5</span>
            <span class="stat-label">Certifications earned</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EDUCATION -->
  <section style="background: var(--bg2);">
    <div class="container">
      <span class="section-label">Education</span>
      <h2>Academic Path</h2>
      <div class="edu-grid">

        <div class="edu-card">
          <div class="edu-year">Sep 2024 — Jul 2027</div>
          <div class="edu-content">
            <h3>International Business Management (IBM)</h3>
            <span class="edu-school">UC Leuven-Limburg · Marketing option</span>
          </div>
        </div>

        <div class="edu-card">
          <div class="edu-year">Jun — Jul 2026</div>
          <div class="edu-content">
            <h3>International Summer Program</h3>
            <span class="edu-school">Korea University · Linear Algebra</span>
          </div>
        </div>

        <div class="edu-card">
          <div class="edu-year">Feb — Jun 2024</div>
          <div class="edu-content">
            <h3>Bachelor of Science, Biomedical Sciences</h3>
            <span class="edu-school">Université Libre de Bruxelles (ULB)</span>
          </div>
        </div>

        <div class="edu-card">
          <div class="edu-year">Sep 2023 — Jan 2024</div>
          <div class="edu-content">
            <h3>Bachelor of Arts, Political Science</h3>
            <span class="edu-school">Université Libre de Bruxelles (ULB)</span>
          </div>
        </div>

        <div class="edu-card">
          <div class="edu-year">Sep 2009 — Jul 2023</div>
          <div class="edu-content">
            <h3>European Baccalaureate</h3>
            <span class="edu-school">European School of Luxembourg I</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section>
    <div class="container">
      <span class="section-label">Skills &amp; Languages</span>
      <h2>Capabilities</h2>
      <div class="skills-grid">

        <div class="skills-block">
          <h4>Core Skills</h4>
          <ul class="skill-list">
            <li><span class="skill-dot"></span>Product Innovation</li>
            <li><span class="skill-dot"></span>Pitch &amp; Presentation</li>
            <li><span class="skill-dot"></span>Linear Algebra</li>
            <li><span class="skill-dot"></span>Business Strategy &amp; Go-to-Market</li>
            <li><span class="skill-dot"></span>Stakeholder Engagement</li>
            <li><span class="skill-dot"></span>Social Media</li>
          </ul>
        </div>

        <div class="skills-block">
          <h4>Languages</h4>
          <div class="lang-list">
            <div class="lang-item">
              <div class="lang-name">
                <span>French</span>
                <span class="lang-level">Native</span>
              </div>
              <div class="lang-bar"><div class="lang-fill" style="width:100%"></div></div>
            </div>
            <div class="lang-item">
              <div class="lang-name">
                <span>English</span>
                <span class="lang-level">Full Professional</span>
              </div>
              <div class="lang-bar"><div class="lang-fill" style="width:85%"></div></div>
            </div>
            <div class="lang-item">
              <div class="lang-name">
                <span>German</span>
                <span class="lang-level">Limited Working</span>
              </div>
              <div class="lang-bar"><div class="lang-fill" style="width:40%"></div></div>
            </div>
            <div class="lang-item">
              <div class="lang-name">
                <span>Dutch</span>
                <span class="lang-level">Limited Working</span>
              </div>
              <div class="lang-bar"><div class="lang-fill" style="width:40%"></div></div>
            </div>
          </div>
        </div>

        <div class="skills-block">
          <h4>Certifications</h4>
          <ul class="cert-list">
            <li><div class="cert-icon">✓</div><span>LinkedIn Marketing Strategy</span></li>
            <li><div class="cert-icon">✓</div><span>Graphic Design Essentials</span></li>
            <li><div class="cert-icon">✓</div><span>SEO Essentials with Semrush</span></li>
            <li><div class="cert-icon">✓</div><span>Getting Started with Semrush</span></li>
            <li><div class="cert-icon">✓</div><span>Inbound Sales</span></li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <CtaStrip
    title="Want to know more?"
    text="Reach out — always happy to chat."
    primary={{ href: "/contact.html", label: "Get in Touch" }}
    secondary={{ href: "/work.html", label: "See My Work" }}
  />

</BaseLayout>
