---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaStrip from '../components/CtaStrip.astro';
---

<BaseLayout
  title="Work — Hélène David"
  description="Experience of Hélène David — CEO & co-founder of CalmCampus and Head of Social Media at Insignia."
>
  <PageHero label="Experience" lead="Building CalmCampus and leading social media at Insignia, an international student organisation.">
    What I've <em>Built</em>
  </PageHero>

  <!-- TIMELINE -->
  <section style="background: var(--bg2);">
    <div class="container">
      <div class="timeline">

        <div class="timeline-item featured">
          <div class="timeline-meta">
            <span class="timeline-date">Jan 2026 — Present</span>
            <span class="timeline-badge">Current</span>
          </div>
          <div class="timeline-body">
            <div class="timeline-header">
              <h3>CEO &amp; Co-Founder</h3>
              <span class="timeline-org">CalmCampus</span>
            </div>
            <p>Building CalmCampus — a privacy-first student wellbeing platform developed through the KU Leuven KICK Challenge in partnership with KU Leuven STUVO. The platform identifies early burnout risk through passive behavioural signals and on-device AI, without daily self-reporting or individual surveillance.</p>
            <ul class="timeline-highlights">
              <li>Defining business strategy, value proposition, and go-to-market approach</li>
              <li>Leading stakeholder conversations with universities, student services, and partners</li>
              <li>Translating student wellbeing needs into a scalable, ethically responsible model</li>
              <li>Developing pitch, partnership strategy, and early validation roadmap</li>
              <li>Aligning product vision, impact goals, and business feasibility</li>
            </ul>
            <div class="timeline-tags">
              <span>Product Strategy</span>
              <span>Stakeholder Engagement</span>
              <span>EdTech</span>
              <span>Privacy-first AI</span>
              <span>Go-to-Market</span>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-meta">
            <span class="timeline-date">Sep 2025 — Present</span>
            <span class="timeline-badge">Current</span>
          </div>
          <div class="timeline-body">
            <div class="timeline-header">
              <h3>Head of Social Media</h3>
              <span class="timeline-org">Insignia</span>
            </div>
            <p>Overseeing a small team to manage the organisation's online presence and create engaging digital content for this international student organisation.</p>
            <div class="timeline-tags">
              <span>Social Media Strategy</span>
              <span>Content Creation</span>
              <span>Team Leadership</span>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-meta">
            <span class="timeline-date">Sep 2024 — Sep 2025</span>
          </div>
          <div class="timeline-body">
            <div class="timeline-header">
              <h3>Member</h3>
              <span class="timeline-org">Insignia</span>
            </div>
            <p>Helped plan and coordinate student-focused events as a member of this international student organisation.</p>
            <div class="timeline-tags">
              <span>Event Planning</span>
              <span>Student Events</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <CtaStrip
    title="Interested in working together?"
    text="I'm always open to new conversations — whether about a project, partnership, or just to connect."
    primary={{ href: "/contact.html", label: "Get in Touch" }}
    secondary={{ href: "/about.html", label: "More About Me" }}
  />

</BaseLayout>
