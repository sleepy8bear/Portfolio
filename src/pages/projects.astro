---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaStrip from '../components/CtaStrip.astro';
import { projects, categories } from '../data/projects';

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title="Projects — Hélène David"
  description="Projects by Hélène David: CalmCampus (KU Leuven KICK Challenge finalist), an AI hackathon app, brand identities, typographic work and marketing campaigns."
>
  <PageHero label="projects" lead="Product, marketing and design work from the last two years. Open any row for the full story.">
    Things I’ve <em>made</em>
  </PageHero>

  <section>
    <div class="container">
      <div class="filters" role="group" aria-label="Filter projects">
        <span class="hand">show me:</span>
        <button class="chip" data-filter="all" aria-pressed="true">All</button>
        {Object.entries(categories).map(([key, label]) => (
          <button class="chip" data-filter={key} aria-pressed="false">{label}</button>
        ))}
        <span class="hand" style="margin-left:auto"><span id="project-count">{projects.length}</span> projects</span>
      </div>

      <div class="project-list">
        {projects.map((p, i) => (
          <details class="project reveal" id={p.id} data-cat={p.cat}>
            <summary>
              <span class="no">{pad(i + 1)}</span>
              <div>
                <h3 class="title">{p.title}</h3>
                <p class="sum">{p.summary}</p>
              </div>
              <span class="side">
                <span class="when">{p.date}</span>
                <span class="toggle" aria-hidden="true">+</span>
              </span>
            </summary>
            <div class="detail">
              <div>
                <span class="kind">{p.kind} · {p.date}</span>
                {p.body.map((para) => <p>{para}</p>)}
                <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip
    text="Happy to share more about the thinking behind any of these."
    primary={{ href: '/contact.html', label: 'Get in touch' }}
    secondary={{ href: '/work.html', label: 'See my experience' }}
  >
    Like what <em>you see</em>?
  </CtaStrip>
</BaseLayout>
