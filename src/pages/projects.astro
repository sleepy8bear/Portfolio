---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaStrip from '../components/CtaStrip.astro';
import Marquee from '../components/Marquee.astro';
import Float from '../components/Float.astro';
import { projects } from '../data/projects';

const pad = (n: number) => String(n).padStart(2, '0');
const tilt = [-1.6, 1.1, -0.6, 1.8, -1.1, 0.7];
const enclTilt = [-2.2, 1.6, -1, 2.4];
const fileCount = (p: (typeof projects)[number]) => (p.files?.length ?? 0) + (p.link ? 1 : 0);
---

<BaseLayout
  title="Projects — Hélène David"
  description="Projects by Hélène David: CalmCampus (KU Leuven KICK Challenge finalist), an AI hackathon app, brand identities, typographic work and marketing campaigns."
>
  <PageHero label="projects" lead="Eleven little letters, one per project. Pick an envelope to open it.">
    Things I’ve <em>made</em>
  </PageHero>

  <Marquee items={['Product', 'Marketing', 'Design', 'Open a letter', 'Typography', 'Campaigns', 'Startups']} tone="custard" reverse />

  <section class="has-float mail-section">
    <Float kind="flower" color="blush" size={150} speed={0.12} spin style="right:-50px;top:14%" />
    <Float kind="star" color="custard" size={100} speed={-0.1} style="left:-30px;top:58%" />
    <div class="container">
      <p class="mailbox-note reveal">
        <svg viewBox="0 0 24 56" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 20 V40 a7 7 0 0 1 -14 0 V12 a5.5 5.5 0 0 1 11 0 V38 a3.5 3.5 0 0 1 -7 0 V18" /></svg>
        <span><span class="hand">psst:</span> a little paperclip means there are files tucked inside the letter<span class="more">, like decks, photos and links</span>.</span>
      </p>

      <div class="mailbox">
        {projects.map((p, i) => (
          <button
            type="button"
            class="envelope reveal"
            data-id={p.id}
            data-cat={p.cat}
            aria-haspopup="dialog"
            style={`--r:${tilt[i % tilt.length]}deg; --n:${i % 3}; --sr:${i % 2 ? 9 : -8}deg`}
          >
            <span class="env-letter" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="env-front" aria-hidden="true"></span>
            <svg class="env-folds" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <polygon class="fold-side" points="0,0 50,56 0,100" />
              <polygon class="fold-side" points="100,0 50,56 100,100" />
              <polygon class="fold-bottom" points="0,100 50,52 100,100" />
              <path d="M0 100 L50 52 L100 100" />
              <path d="M0 0 L50 56" /><path d="M100 0 L50 56" />
            </svg>
            <span class="env-flap" aria-hidden="true">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none"><polygon points="0,0 100,0 50,100" /></svg>
            </span>
            <span class="env-date" aria-hidden="true">{p.date}</span>
            <svg class="env-postmark" viewBox="0 0 150 80" aria-hidden="true">
              <defs><path id={`pm-${p.id}`} d="M108 40 m-27 0 a27 27 0 1 1 54 0 a27 27 0 1 1 -54 0" /></defs>
              <circle cx="108" cy="40" r="35" fill="none" stroke="currentColor" stroke-width="2" />
              <circle cx="108" cy="40" r="21" fill="none" stroke="currentColor" stroke-width="1.5" />
              <text font-family="Instrument Sans, sans-serif" font-weight="700" font-size="8.4" letter-spacing="1.8" fill="currentColor"><textPath href={`#pm-${p.id}`} startOffset="1">LEUVEN ✺ BELGIUM ✺</textPath></text>
              <path d="M4 24 q9 -7 18 0 t18 0 t18 0 M4 40 q9 -7 18 0 t18 0 t18 0 M4 56 q9 -7 18 0 t18 0 t18 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <span class="env-air" aria-hidden="true"></span>
            <span class="env-seal" aria-hidden="true">{pad(i + 1)}</span>
            <span class="env-label">
              {fileCount(p) > 0 && (
                <span class="env-clip" aria-hidden="true">
                  <svg viewBox="0 0 24 56" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M17 20 V40 a7 7 0 0 1 -14 0 V12 a5.5 5.5 0 0 1 11 0 V38 a3.5 3.5 0 0 1 -7 0 V18" /></svg>
                  <b>{fileCount(p)}</b>
                </span>
              )}
              <span class="env-title">{p.title}</span>
              <span class="env-teaser">{p.teaser}</span>
              {fileCount(p) > 0 && <span class="sr-only">{fileCount(p)} attached {fileCount(p) === 1 ? 'file' : 'files'}</span>}
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {projects.map((p) => (
    <template id={`tpl-${p.id}`}>
      <span class="kind">{p.kind} · {p.date}</span>
      <h3 class="letter-title" id="letter-title">{p.title}</h3>
      {p.body.map((para) => <p>{para}</p>)}
      <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
      {fileCount(p) > 0 && (
        <div class="enclosed">
          <span class="hand">enclosed with this letter:</span>
          <div class="enclosures">
            {(p.files ?? []).map((f, i) => (
              <button
                type="button"
                class:list={['enclosure', { 'is-stack': f.pages > 1 }]}
                data-viewer
                data-path={`/projects/${p.id}/${f.slug}/`}
                data-pages={f.pages}
                data-title={f.title}
                data-ratio={(f.w / f.h).toFixed(3)}
                style={`--r:${enclTilt[i % enclTilt.length]}deg; --ratio:${(f.w / f.h).toFixed(3)}`}
              >
                <span class="enc-clip" aria-hidden="true"></span>
                <span class="enc-paper"><img src={`/projects/${p.id}/${f.slug}/cover.jpg`} alt="" loading="lazy" width="280" height={Math.round(280 / (f.w / f.h))} /></span>
                <span class="enc-cap">{f.title}</span>
                <span class="enc-meta">{f.pages > 1 ? `${f.pages} pages` : 'image'} · open</span>
              </button>
            ))}
            {p.link && (
              <a class="enclosure enclosure--link" href={p.link.href} target="_blank" rel="noopener" style={`--r:${enclTilt[(p.files?.length ?? 0) % enclTilt.length]}deg`}>
                <span class="enc-clip" aria-hidden="true"></span>
                <span class="enc-postcard"><b>↗</b><i>{p.link.note}</i></span>
                <span class="enc-cap">{p.link.label}</span>
                <span class="enc-meta">github.com · opens a new tab</span>
              </a>
            )}
          </div>
        </div>
      )}
      <p class="signature">with love, Hélène ✺</p>
    </template>
  ))}

  <dialog id="letter" class="letter" aria-labelledby="letter-title">
    <div class="sheet">
      <button type="button" class="letter-close" data-close aria-label="Close letter">×</button>
      <div class="sheet-body"></div>
      <nav class="sheet-nav" aria-label="Letters">
        <button type="button" data-prev>← previous</button>
        <span class="sheet-count" aria-live="polite"></span>
        <button type="button" data-next>next →</button>
      </nav>
    </div>
  </dialog>

  <dialog id="viewer" class="viewer" aria-labelledby="viewer-title">
    <div class="viewer-frame">
      <header class="viewer-head">
        <h3 id="viewer-title"></h3>
        <button type="button" class="viewer-close" data-vclose aria-label="Close file">×</button>
      </header>
      <div class="viewer-stage">
        <button type="button" class="viewer-arrow viewer-prev" data-vprev aria-label="Previous page">←</button>
        <img class="viewer-img" alt="" />
        <button type="button" class="viewer-arrow viewer-next" data-vnext aria-label="Next page">→</button>
      </div>
      <footer class="viewer-foot">
        <input type="range" class="viewer-range" min="1" max="1" value="1" aria-label="Page" />
        <span class="viewer-count" aria-live="polite"></span>
      </footer>
    </div>
  </dialog>

  <CtaStrip
    text="Happy to share more about the thinking behind any of these."
    primary={{ href: '/contact.html', label: 'Get in touch' }}
    secondary={{ href: '/work.html', label: 'See my experience' }}
  >
    Like what <em>you see</em>?
  </CtaStrip>
</BaseLayout>
