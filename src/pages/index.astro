---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import Marquee from '../components/Marquee.astro';
import CtaStrip from '../components/CtaStrip.astro';
import Float from '../components/Float.astro';
import { projects } from '../data/projects';

const byId = (id: string) => projects.find((p) => p.id === id)!;
const main = byId('calmcampus');
const side = [byId('study-far-far-away'), byId('snow-white')];
const ticker = ['Brand identity', 'Marketing strategy', 'Typography', 'Pitching', 'Product design', 'SEO', 'Campaign design', 'Startups'];
---

<BaseLayout
  title="Hélène David — Portfolio"
  description="Hélène David — International Business Management student (marketing option), CEO & co-founder of CalmCampus, working across brand, marketing and product. Based in Leuven, Belgium."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="hero-hello">
          <span class="hand">hi, I’m</span>
          <svg viewBox="0 0 56 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6 C 14 4, 30 14, 44 30 M33 31 L45 31 L44 19" /></svg>
        </div>
        <h1 class="hero-title" data-split data-hero><span>Hélène</span><em>David</em></h1>
        <p class="hero-lead">
          International Business Management student based in Leuven, building{' '}
          <span class="squiggle">CalmCampus</span>, a privacy-first wellbeing app that reached the KU Leuven KICK finals.
        </p>
        <div class="hero-actions">
          <a href="/projects.html" class="btn btn--flamingo">See the projects ↘</a>
          <a href="/about.html" class="btn">About me</a>
        </div>
      </div>
      <HeroArt />
    </div>
  </section>

  <Marquee items={ticker} />

  <section class="has-float">
    <Float kind="star" color="custard" size={110} speed={0.14} spin style="right:3%;top:2%" />
    <Float kind="ring" color="blush" size={90} speed={-0.1} style="left:-30px;bottom:6%" />
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">selected work</span>
          <h2 data-split>A few things<br />I’m <em>proud</em> of</h2>
        </div>
        <a href="/projects.html" class="link-arrow">All {projects.length} projects →</a>
      </div>

      <div class="featured">
        <a href={`/projects.html#${main.id}`} class="paper paper--custard reveal" style="--r:-1deg">
          <div class="meta"><span>{main.kind}</span><span>{main.date}</span></div>
          <h3>{main.title}</h3>
          <p>{main.summary} Developed for the KU Leuven KICK Challenge 2026, where it reached the finals.</p>
          <div class="tags">{main.tags.map((t) => <span>{t}</span>)}</div>
          <span class="big-no" aria-hidden="true">01</span>
        </a>

        <div class="paper-stack">
          {side.map((p, i) => (
            <a href={`/projects.html#${p.id}`} class:list={['paper', i === 0 ? 'paper--blush' : 'paper--flamingo', 'reveal']} style={`--r:${i === 0 ? 1.5 : -1.5}deg; --tape:${i === 0 ? 4 : -5}deg`}>
              <div class="meta"><span>{p.kind}</span><span>{p.date}</span></div>
              <h3 style="font-size: clamp(1.6rem, 3vw, 2.4rem)">{p.title}</h3>
              <p>{p.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="tint has-float">
    <Float kind="blob" color="flamingo" size={130} speed={0.12} style="left:-40px;top:10%" />
    <Float kind="flower" color="blush" size={120} speed={-0.08} style="right:-20px;bottom:8%" />
    <div class="container intro">
      <p class="intro-quote reveal">
        I’m fascinated by how the world works, and by <em><span class="mark">decoding</span></em> how people think.
      </p>
      <div class="note-card reveal">
        <span class="hand">quick facts</span>
        <ul>
          <li>21, living in Leuven</li>
          <li>IBM student, marketing option</li>
          <li>FR · EN · NL · DE</li>
          <li><b data-count={projects.length}>{projects.length}</b> projects &amp; counting</li>
        </ul>
      </div>
    </div>
  </section>

  <CtaStrip
    text="About CalmCampus, a project, student wellbeing, or just to say hi."
    primary={{ href: '/contact.html', label: 'Say hello' }}
    secondary={{ href: '/work.html', label: 'See my experience' }}
  >
    Let’s make <em>something</em>.
  </CtaStrip>
</BaseLayout>
