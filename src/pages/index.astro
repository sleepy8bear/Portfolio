---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaStrip from '../components/CtaStrip.astro';
---

<BaseLayout
  title="Hélène David — Portfolio"
  description="Hélène David — International Business Management student (Marketing option) and CEO & co-founder of CalmCampus. Based in Leuven, Belgium."
>
  <!-- HERO -->
  <section id="hero">
    <div class="hero-content">
      <p class="hero-tag">International Business Management · Marketing · Leuven, Belgium</p>
      <h1>Hélène<br /><em>David</em></h1>
      <p class="hero-sub">Building ventures at the intersection of technology, ethics, and human behaviour.</p>
      <div class="hero-actions">
        <a href="/work.html" class="btn btn-primary">View My Work</a>
        <a href="/about.html" class="btn btn-ghost">About Me</a>
      </div>
    </div>
    <div class="hero-scroll">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- STATS -->
  <div class="stats-strip">
    <div class="stat-item">
      <span class="stat-num">2+</span>
      <span class="stat-label">Years at Insignia</span>
    </div>
    <div class="stat-item">
      <span class="stat-num">4</span>
      <span class="stat-label">Languages spoken</span>
    </div>
    <div class="stat-item">
      <span class="stat-num">5</span>
      <span class="stat-label">Certifications</span>
    </div>
  </div>

  <!-- FEATURED WORK -->
  <section class="featured-section">
    <div class="container">
      <span class="section-label">Featured Work</span>
      <h2>What I'm Building</h2>
      <a href="/work.html" class="featured-card">
        <div>
          <div class="featured-label">CEO &amp; Co-Founder · Jan 2026 — Present</div>
          <h3>CalmCampus</h3>
          <p>A privacy-first student wellbeing platform developed through the KU Leuven KICK Challenge. CalmCampus identifies early burnout risk through passive behavioural signals and on-device AI — without daily self-reporting or individual surveillance.</p>
          <div class="featured-tags">
            <span>Product Strategy</span>
            <span>EdTech</span>
            <span>Privacy-first AI</span>
            <span>Stakeholder Engagement</span>
            <span>KU Leuven KICK</span>
          </div>
          <span class="btn btn-primary" style="pointer-events:none;">See All Work →</span>
        </div>
        <div class="featured-arrow">↗</div>
      </a>
    </div>
  </section>

  <!-- OTHER WORK -->
  <section class="other-work-section">
    <div class="container">
      <span class="section-label">Also</span>
      <h2>Beyond CalmCampus</h2>
      <div class="work-grid">
        <div class="work-card">
          <div class="work-card-meta">
            <span class="work-card-role">Head of Social Media</span>
            <span class="work-card-date">Sep 2025 — Present</span>
          </div>
          <h3>Insignia</h3>
          <p>Overseeing a small team that manages the online presence of this international student organisation and creates engaging digital content.</p>
          <div class="work-card-tags">
            <span>Social Media</span><span>Content</span><span>Team Lead</span>
          </div>
        </div>
        <div class="work-card">
          <div class="work-card-meta">
            <span class="work-card-role">Summer Program</span>
            <span class="work-card-date">Jun — Jul 2026</span>
          </div>
          <h3>Korea University</h3>
          <p>International Summer Program in Linear Algebra.</p>
          <div class="work-card-tags">
            <span>Linear Algebra</span><span>International</span>
          </div>
        </div>
      </div>
      <a href="/projects.html" class="btn btn-ghost" style="margin-top: 2rem;">See all projects →</a>
    </div>
  </section>

  <CtaStrip
    title="Let's Connect"
    text="Interested in CalmCampus, student wellbeing, or just want to say hello? Get in touch."
    primary={{ href: "/contact.html", label: "Get in Touch" }}
    secondary={{ href: "/about.html", label: "Learn More About Me" }}
  />

</BaseLayout>
