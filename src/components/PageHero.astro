---
// Title block at the top of every inner page. The default slot is the <h1> content
// (so it can contain <em> and <br />).
interface Props {
  label: string;
  lead: string;
}
const { label, lead } = Astro.props;
---

<header class="page-hero">
  <div class="container">
    <a href="/" class="back-link">← Home</a><br />
    <span class="eyebrow">{label}</span>
    <h1><slot /></h1>
    <p class="lead">{lead}</p>
  </div>
</header>
