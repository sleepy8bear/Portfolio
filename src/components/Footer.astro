---
const year = new Date().getFullYear();
const links = [
  { href: '/work.html', label: 'Work' },
  { href: '/projects.html', label: 'Projects' },
  { href: '/about.html', label: 'About' },
  { href: '/contact.html', label: 'Contact' },
];
---

<footer>
  <div class="container">
    <div class="footer-top">
      <p class="footer-word">Hélène<br /><em>David</em></p>
      <a href="/" class="logo-badge" aria-label="Hélène David — home">
        <img src="/logo.png" alt="Hélène David" width="400" height="400" loading="lazy" />
      </a>
    </div>
    <div class="footer-bottom">
      <nav class="footer-links" aria-label="Footer">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="https://www.linkedin.com/in/helenedavid11" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:helene.david@proton.me">Email</a>
      </nav>
      <p>© {year} Hélène David · made in Leuven</p>
    </div>
  </div>
</footer>
