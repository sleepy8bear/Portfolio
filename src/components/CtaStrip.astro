---
// Big closing call-to-action. The default slot is the headline.
interface Props {
  text: string;
  primary: { href: string; label: string };
  secondary: { href: string; label: string };
}
const { text, primary, secondary } = Astro.props;
---

<section class="cta">
  <svg class="deco deco--star" viewBox="0 0 100 100" aria-hidden="true">
    <polygon points="50,2 61,36 98,36 68,58 79,94 50,72 21,94 32,58 2,36 39,36" fill="#ffd95a" stroke="#1c1814" stroke-width="3" stroke-linejoin="round" />
  </svg>
  <span class="deco deco--circle" aria-hidden="true"></span>
  <div class="container">
    <h2><slot /></h2>
    <p>{text}</p>
    <div class="cta-actions">
      <a href={primary.href} class="btn btn--tomato">{primary.label}</a>
      <a href={secondary.href} class="btn">{secondary.label}</a>
    </div>
  </div>
</section>
