---
// A little "postcard" for an Instagram account. The live feed preview is click-to-load,
// so nothing from Instagram (Meta) is requested until the visitor presses the button.
interface Props {
  handle: string;
  name: string;
  bio: string;
  id: string;
}
const { handle, name, bio, id } = Astro.props;
const url = `https://www.instagram.com/${handle}/`;
const embed = `https://www.instagram.com/${handle}/embed/`;
---

<aside class="insta reveal" aria-label={`${name} on Instagram`}>
  <div class="insta-card">
    <div class="insta-head">
      <span class="insta-avatar" aria-hidden="true">in</span>
      <div class="insta-id">
        <b>@{handle}</b>
        <span>{name}</span>
      </div>
      <svg class="insta-logo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" />
      </svg>
    </div>
    <p class="insta-bio">{bio}</p>
    <div class="insta-tiles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="insta-actions">
      <a class="btn btn--blush" href={url} target="_blank" rel="noopener">Open on Instagram ↗</a>
      <button type="button" class="btn" data-insta-toggle data-target={id} data-embed={embed} data-title={`${name} on Instagram`} aria-expanded="false" aria-controls={id}>
        <span>Preview the feed</span>
      </button>
    </div>
    <p class="insta-note">The preview loads from Instagram when you press the button.</p>
  </div>
  <div class="insta-embed" id={id} hidden></div>
</aside>
